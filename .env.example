# MERIDIAN — variabile de mediu
#
# Copiază în `.env.local` pentru dezvoltare. În producție se setează în
# Vercel → Project Settings → Environment Variables (Production + Preview).
#
# Fișierul ăsta e ȘABLON și e versionat intenționat (vezi excepția din
# `.gitignore`). NU pune valori reale aici — `.env.local` e ignorat de git.
#
# Coloana „fără ea": ce se strică dacă lipsește. Detaliat în README.

# --- Site -------------------------------------------------------------------
# Din ea se construiesc canonical, hreflang, sitemap și robots. Dacă e greșită,
# tot SEO-ul arată spre alt domeniu. Fără schema `https://` nu e URL valid.
NEXT_PUBLIC_SITE_URL=https://meridianx.ro

# --- Supabase (baza de lead-uri + autentificarea de admin) ------------------
# Fără ele: în dezvoltare formularele răspund 201 cu id sintetic și lead-ul se
# scrie doar în consola serverului; în PRODUCȚIE răspund 503, ca să nu se
# piardă lead-uri în tăcere. `/admin` arată ecranul de instalare.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ocolește RLS — se folosește DOAR pe server. Nu are prefix NEXT_PUBLIC_ și nu
# trebuie să capete vreodată unul: ar ajunge în bundle-ul de browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cine are voie în /admin. Adrese separate prin virgulă.
# OBLIGATORIE ÎN PRODUCȚIE: proiectele Supabase acceptă înregistrarea prin
# email implicit, deci fără listă oricine își face cont pe proiect și vede
# toate lead-urile. Fără ea, în producție panoul se blochează intenționat;
# în dezvoltare trece orice cont, ca să se poată lucra.
ADMIN_EMAILS=

# --- Email tranzacțional (Resend) -------------------------------------------
# Fără cheie nu pleacă nicio notificare și nicio confirmare. Lead-ul se salvează
# oricum — un email eșuat nu strică niciodată un lead.
RESEND_API_KEY=
# Unde ajung notificările de lead nou. Acceptă mai multe adrese despărțite prin
# virgulă. Fără ea, nimeni nu află de lead-uri noi.
LEAD_NOTIFICATION_EMAIL=
# Adresa expeditor, verificată în Resend pe domeniul tău. Dacă domeniul nu e
# verificat, Resend refuză trimiterea.
RESEND_FROM_EMAIL=MERIDIAN <notificari@meridianx.ro>

# --- Canale de contact ------------------------------------------------------
# Fără ele site-ul afișează numere de DEMONSTRAȚIE și scrie asta în subsol
# („datele de contact sunt placeholder"). Butoanele de telefon și WhatsApp
# există oricum — clientul de video le folosește cel mai des (CLAUDE.md §8) —
# dar duc în gol până completezi aici.
# Format internațional: +40 7xx xxx xxx. WhatsApp îl acceptă și cu spații.
# Numerele stau in cod (components/site/contact.ts) fiindca sunt date
# publice si trebuie sa ajunga in productie si fara env. Variabilele de
# mai jos sunt DOAR pentru schimbare fara redeploy; lasate goale, se
# folosesc numerele din cod.
NEXT_PUBLIC_PHONE_VIDEO=
NEXT_PUBLIC_PHONE_SOFTWARE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Adrese separate per divizie: fiecare lume are propriul ton și propria cutie.
NEXT_PUBLIC_EMAIL_VIDEO=
NEXT_PUBLIC_EMAIL_SOFTWARE=
# Apare doar în structured data (`sameAs`), nu în interfață.
NEXT_PUBLIC_INSTAGRAM=
