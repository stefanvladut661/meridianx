# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...dar șablonul TREBUIE să fie în repo: fără el, la un clone nou sau la
# configurarea Vercel nimeni nu are lista de variabile. Nu conține secrete.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# referințe de design (screenshot-uri de inspirație, nu fac parte din build)
/ideas/

# material brut lăsat în rădăcină (ex. „art install.mp4”, 184MB): sursa
# de montaj, nu ce se servește — varianta web stă în public/, comprimată.
# GitHub refuză oricum fișiere peste 100MB.
/*.mp4
/*.mov

.vercel
.env*
